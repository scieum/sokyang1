# 공공데이터포털(data.go.kr) 국토교통부 TAGO API 서비스 키
# 발급 후 아래에 입력하고 이 파일을 .env 로 복사하세요. (.env 는 커밋 금지)
TAGO_SERVICE_KEY=

# 속초시 도시코드 (TAGO cityCode). 실제 값으로 교체하세요.
SOKCHO_CITY_CODE=32310

# 서버 설정
SERVER_PORT=4000

# Redis 연결 (없으면 인메모리 캐시로 자동 폴백)
REDIS_URL=redis://127.0.0.1:6379

# 풀링 주기 (밀리초)
POLL_INTERVAL_MS=3000

# 실데이터 없이 모의 데이터로 구동 (true/false)
USE_MOCK=true
